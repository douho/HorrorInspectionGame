    characterSetSelectionMode: 8
    characterSequence: "\u507D\u751F\u7269\u6AA2\u67E5\u7AD9\u4E0B\u4E0D\u4E2D\u4EBA\u4EF6\u4F4E\u5165\u5168\u518A\u51FA\u5206\u5224\u529F\u52FF\u5371\u53E3\u53E5\u53EF\u5408\u55AE\u5668\u56DE\u5916\u5927\u5931\u5973\u59CB\u5A66\u5B58\u5B89\u5B9A\u5BB9\u5BDF\u5E38\u5F35\u5F62\u5FB5\u6025\u610F\u614C\u6210\u6232\u624B\u767D\r\n\u6307\u6309\u63D0\u64C7\u64CA\u653E\u6557\u6591\u65B7\u661F\u672C\u675F\u67E5\u684C\u6A94\u6AA2\u6B63\u6BBA\u6CE8\u6E05\u70BA\u7236\u7248\u7259\u7269\u7279\u7532\u7537\u756B\u7570\u7591\u76E3\u773C\u775B\u78BA\u793A\u795E\u7B11\u7B26\u7D00\u7D50\u7DCA\u7F3A\u7F6E\u8001\u80CC\u814B\u884C\r\n\u8996\u89C0\u8A00\u8A2D\u8A6D\u8A8D\u8A9E\u8ACB\u8B49\u8B8A\u8EAB\u8ECD\u8F09\u8FD4\u9000\u901A\u904A\u9078\u90E8\u91CF\u9215\u9304\u958B\u9677\u96AA\u96E2\u9762\u97F3\u985E\u9A57\u9AD8\u9EDE\u9F52\u904A\u6232\u958B\u59CB\u7E7C\u7E8C\u8A2D\u5B9A\u96E2\u958B\u78BA\u8A8D\u53D6\u6D88\u6309\r\n\u4E0B\u8FD4\u56DE\u4E3B\u9078\u55AE\u6575\u653B\u64CA\u52DD\u5229\u5931ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxy\r\nz0123456789\uFF01\uFF1F\u3002\u3001\uFF1A\uFF1B\u300C\u300D\u300E\u300F\uFF5E\xB7\u2014\u2026%+-=()[]<>\u2192\u67E5\u770B\u76E3\u8996\u5668\uFF08LR\u9375\u5207\u63DB\u8996\u7A97\uFF09\u653E\u5927\u5DE6\u985E\r\n\u6BD4\u9078\u64C7\u90E8\u4F4D\u5634\u5141\u53CA\u9032\u6309A\u64CAB\u524D\u500B\u80CC\u666F\u8207\u4E16\u754C\u89C0\u73FE\u7D04\u897F\u5143\u5730\u7403\u5DF2\u9069\u5C45\u5C0B\u4ED6\u661F\u822A\u592A\u7522\u7570\u5E38\u8FC5\u5118\u79D1\u767C\u5C55\u5C0D\u65BC\u5E36\u66F4\u591A\u5E0C\r\n\u671B\u98DB\u5FEB\u8853\u4F7F\u5F97\u968E\u968E\u91D1\u4F5C\u5340\u5206\u667A\u8D8A\u9AD8\u529B\u4E0A\u653F\u5BB6\u624B\u8CC7\u8A0A\u8166\u61C2\u4F55\u8070\u660E\u5730\u624D\u64C1\u6709\u9802\u7AEF\u624D\u5011\u8A02\u4E00\u5EA6\u521D\u76EE\u4FBF\u5C64\u52A9\u7136\u96A8\u8457\u592A\u7A7A\r\n\u8D8A\u767C\u9054\u4F86\u5B87\u5B99\u5404\u7A2E\u7136\u63A5\u5230\u540D\u4ED6\u770B\u6E96\u6B64\u85C9\u507D\u88DD\u5E95\u6DF7\u7FA4\u4E4B\u7D71\u7A31\u82E5\u57FA\u6975\u6EC5\u98A8\u96AA\u6240\u5E78\u89E3\u5920\u6E96\u78BA\u73A9\u76EE\u6A19\u52D9\u8AAA\u660E\u5C07\u626E\u6F14\u4F4D\u4E2D\r\n\u4E0A\u7D1A\u7A7A\u95DC\u5225\u5883\u626E\u54E1\u4F9D\u7167\u524D\u5FB5\u9032\u6839\u64DA\u679C\u53EF\u9078\u53CA\u7DCA\u57FA\u79D1\u89C0\u4E3B\u7259\u9F52\u6392\u6975\u6574\u9F4A\u6F54\u6578\u9060\u591A\u65BC\u61C9\u8A31\u660E\u7D05\u814B\u6BDB\u76BA\u8936\u7121\u95DC\u7BC0\u7D44\u529B\r\n\u7528\u975E\u908F\u53E5\u70BA\u5916\u5DEE\u8B8A\u6700\u5168\u56E0\u4E5F\u5177\u6CD5\u6027\u82E5\u9047\u81EA\u547C\u5C08\u6E05\u9664\u4F5C\u5207\u8AD6\u4F55\u60C5\u6CC1\u7DCA\u6211\u6703\u76E1\u901F\u5354\u60A8\u4E09\u63D0\u8FF0\u65B9\u8A2D\u8A08\u9A5A\u5687\u756B\u7D66\u4E0D\u540C\u56DE\r\n\u994B\u4F4E\u5EA6\u7D14\u4E2D\u5916\u52A0\u9707\u52D5\u8ABF\u6BCF\u4F4D\u5BA2\u5834\u689D\u5C0D\u7DDA\u53CD\u7C21\u7B2C\u5A66\u8EAB\u4EFD\u7167\u6548\u65E5\u7686\u78BA\u8AA4\u770B\u4F3C\u79BF\u53F3\u6735\u908A\u4E0A\u5FAE\u9AEE\u8AAA\u51FA\u8A71\u537B\u6027\u5E38\u543E\u6C5D\u64C1\u53E3\r\n\u8B1B\u7D05\u58A8\u93E1\u5206\u9ED1\u5718\u5F62\u9AD4\u9846\u9032\u54EA\u5168\u8457\u4E14\u8F49\u81F3\u89D2\u6642\u7A81\u8CBC\u8FD1\u5E55\u81C9jumpscare\u5E36\u53EA\u7B2C\u8ECD\u901A\u6E9D\u4EF6\u671F\u904E\u6234\u6B63\u5207\u537B\u767C\u80CC\u5168\u9AA8\u9732\u771F\r\n\u80D6\u5B98\u4E5D\u9700\u5F71*I\u540D\u5B57\u7247\r\n\u662F\u5426\u5716\u543B\r\n\u770B\u4F86\u4F60\u5C31\u662F\u65B0\u4F86\u7684\u76E3\u5BDF\u4EBA\u54E1\uFF0C\u63A5\u4E0B\u4F86\u5C07\u4E00\u6B65\u6B65\u5E36\u4F60\u9032\u884C\u6AA2\u67E5\u6D41\u7A0B\u3002\u8ACB\u6309\u7A7A\u767D\u9375\u7E7C\u7E8C\u3002\r\n\u9996\u5148\uFF0C\u8ACB\u6309\u7A7A\u767D\u9375\u6253\u958B\u8EAB\u5206\u8B49\u4EF6\uFF0C\u78BA\u8A8D\u57FA\u672C\u8CC7\u6599\u3002\r\n\u8ACB\u78BA\u4FDD\u8EAB\u5206\u8B49\u982D\u8CBC\u8207\u672C\u4EBA\u76F8\u7B26\uFF0C\u4E14\u8EAB\u5206\u8B49\u5C1A\u5728\u6709\u6548\u671F\u9650\u5167\u3002\u6AA2\u67E5\u5B8C\u7562\u8ACB\u6309
      ESC \u95DC\u9589\u8B49\u4EF6\r\n\u8ACB\u5207\u63DB\u5230\u76E3\u8996\u5668
      CAM002\uFF0C\u78BA\u8A8D\u5165\u95DC\u8005\u773C\u775B\u72C0\u6CC1\u3002\u70BA\u78BA\u4FDD\u5C0D\u8C61\u70BA\u4EBA\u985E\uFF0C\u64DA\u89C0\u5BDF\uFF0C\u300C\u507D\u751F\u7269\u300D\u7684\u773C\u767D\u6703\u6709\u7D05\u8272\u6591\u9EDE\u3002\u8ACB\u591A\u52A0\u6CE8\u610F\r\n\u5F88\u597D\uFF0C\u518D\u8ACB\u8ACB\u5207\u56DE
      CAM001\r\n\u53E6\u5916\u5728\u6AA2\u67E5\u6642\uFF0C\u9664\u4E86\u773C\u775B\uFF0C\u4E5F\u8ACB\u6CE8\u610F\u7259\u9F52\u662F\u5426\u300C\u904E\u5EA6\u6F54\u767D\u6574\u9F4A\u300D\r\n\u63A5\u8457\u6703\u9032\u5165\u6E05\u55AE\u6AA2\u67E5\u6559\u5B78\r\n\u8ACB\u5C07\u6240\u6709\u6AA2\u67E5\u9805\u76EE\u52FE\u9078\u5B8C\u6210\r\n\u8ACB\u5207\u63DB\u5230
      Checklist \u4E26\u6309\u7A7A\u767D\u9375\u958B\u555F\r\n\u8ACB\u6309\u4E0B\u300CSubmit\u300D\u9001\u51FA\uFF0C\u63A5\u8457\u9078\u64C7\u300E\u5141\u8A31\u300F\u6216\u300E\u4E0D\u5141\u8A31\u300F\u5165\u5883\u4EE5\u5B8C\u6210\u5BE9\u67E5\u4F60\u4E5F\u53EF\u4EE5\u5148\u95DC\u9589\u6E05\u55AE\uFF0C\u89C0\u5BDF\u5F8C\u518D\u6C7A\u5B9A\r\n           
      \u505A\u5F97\u4E0D\u932F\uFF0C\u65B0\u4EBA\u3002\u82E5\u6709\u9700\u8981\uFF0C\u53EF\u67E5\u770B\u5DE6\u5074\u7684\u624B\u518A\u3002\r\n           
      \u8A18\u4F4F\u2026\u2026\u300C\u507D\u751F\u7269\u300D\u64C5\u9577\u6A21\u4EFF\uFF0C\u4F60\u7684\u6BCF\u4E00\u500B\u5224\u65B7\uFF0C\u90FD\u6703\u5F71\u97FF\u5230\u57CE\u5E02\u7684\u5B89\u5168\u3002\r\n           
      \u4FDD\u6301\u8B66\u89BA\u5427\u3002\u4E00\u4E8C\u4E09\u56DB\u4E94\u516D\u4E03\u516B\u4E5D\u5341\u7B54\u5C0D\u984C\u6578\u7B54\u932F\u984C\u6578\r\n\u8EAB\u5206\u8B49\u5C1A\u672A\u904E\u671F\r\n0123456789abcdefABCDEF-\u3010\u25CB\u3011\u3010\u3011\xD7\u5DE6\u4E0B\u985E\u6BD4\u6416\u687F\u53F3\u5074\u6AA2\u67E5\u6E05\u55AE"
