    characterSequence: "\u507D\u751F\u7269\u6AA2\u67E5\u7AD9\u4E0B\u4E0D\u4E2D\u4EBA\u4EF6\u4F4E\u5165\u5168\u518A\u51FA\u5206\u5224\u529F\u52FF\u5371\u53E3\u53E5\u53EF\u5408\u55AE\u5668\u56DE\u5916\u5927\u5931\u5973\u59CB\u5A66\u5B58\u5B89\u5B9A\u5BB9\u5BDF\u5E38\u5F35\u5F62\u5FB5\u6025\u610F\u614C\u6210\u6232\u624B\u767D\r\n\u6307\u6309\u63D0\u64C7\u64CA\u653E\u6557\u6591\u65B7\u661F\u672C\u675F\u67E5\u684C\u6A94\u6AA2\u6B63\u6BBA\u6CE8\u6E05\u70BA\u7236\u7248\u7259\u7269\u7279\u7532\u7537\u756B\u7570\u7591\u76E3\u773C\u775B\u78BA\u793A\u795E\u7B11\u7B26\u7D00\u7D50\u7DCA\u7F3A\u7F6E\u8001\u80CC\u814B\u884C\r\n\u8996\u89C0\u8A00\u8A2D\u8A6D\u8A8D\u8A9E\u8ACB\u8B49\u8B8A\u8EAB\u8ECD\u8F09\u8FD4\u9000\u901A\u904A\u9078\u90E8\u91CF\u9215\u9304\u958B\u9677\u96AA\u96E2\u9762\u97F3\u985E\u9A57\u9AD8\u9EDE\u9F52\u904A\u6232\u958B\u59CB\u7E7C\u7E8C\u8A2D\u5B9A\u96E2\u958B\u78BA\u8A8D\u53D6\u6D88\u6309\r\n\u4E0B\u8FD4\u56DE\u4E3B\u9078\u55AE\u6575\u653B\u64CA\u52DD\u5229\u5931ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxy\r\nz0123456789\uFF01\uFF1F\u3002\u3001\uFF1A\uFF1B\u300C\u300D\u300E\u300F\uFF5E\xB7\u2014\u2026%+-=()[]<>\u2192\u67E5\u770B\u76E3\u8996\u5668\uFF08LR\u9375\u5207\u63DB\u8996\u7A97\uFF09\u653E\u5927\u5DE6\u985E\r\n\u6BD4\u9078\u64C7\u90E8\u4F4D\u5634\u5141\u53CA\u9032\u6309A\u64CAB\u524D\u500B\u80CC\u666F\u8207\u4E16\u754C\u89C0\u73FE\u7D04\u897F\u5143\u5730\u7403\u5DF2\u9069\u5C45\u5C0B\u4ED6\u661F\u822A\u592A\u7522\u7570\u5E38\u8FC5\u5118\u79D1\u767C\u5C55\u5C0D\u65BC\u5E36\u66F4\u591A\u5E0C\r\n\u671B\u98DB\u5FEB\u8853\u4F7F\u5F97\u968E\u968E\u91D1\u4F5C\u5340\u5206\u667A\u8D8A\u9AD8\u529B\u4E0A\u653F\u5BB6\u624B\u8CC7\u8A0A\u8166\u61C2\u4F55\u8070\u660E\u5730\u624D\u64C1\u6709\u9802\u7AEF\u624D\u5011\u8A02\u4E00\u5EA6\u521D\u76EE\u4FBF\u5C64\u52A9\u7136\u96A8\u8457\u592A\u7A7A\r\n\u8D8A\u767C\u9054\u4F86\u5B87\u5B99\u5404\u7A2E\u7136\u63A5\u5230\u540D\u4ED6\u770B\u6E96\u6B64\u85C9\u507D\u88DD\u5E95\u6DF7\u7FA4\u4E4B\u7D71\u7A31\u82E5\u57FA\u6975\u